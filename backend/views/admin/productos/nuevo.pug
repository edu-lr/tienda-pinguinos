extends ../../layout

block content
  h2 Nuevo producto
  a.btn.volver(href="/admin/productos") ← Volver

  if error
    .error= error

  form(method="POST" action="/admin/productos")
    .form-group
      label(for="nombre") Nombre *
      input(type="text" id="nombre" name="nombre" value=datos.nombre || '' required)
    .form-group
      label(for="descripcion") Descripción *
      textarea(id="descripcion" name="descripcion" required)= datos.descripcion || ''
    .form-group
      label(for="precio") Precio *
      input(type="number" id="precio" name="precio" step="0.01" min="0" value=datos.precio || '' required)
    .form-group
      label(for="stock") Stock *
      input(type="number" id="stock" name="stock" min="0" value=datos.stock || 0 required)
    .form-group
      label(for="imagen") URL de imagen
      input(type="url" id="imagen" name="imagen" value=datos.imagen || '')
    button(type="submit") Crear producto